# Voicible Configuration
# "Every voice, made visible."
# Copy this file to .env and adjust values for your venue/deployment.

# ─── Voicible Configuration ──────────────────
VENUE_NAME=Voicible Live

# STT Provider: "whisper-live" | "azure"
STT_PROVIDER=whisper-live
WHISPER_LIVE_URL=ws://localhost:9090
WHISPER_LIVE_MODEL=small.en
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth

# LLM Provider: "ollama" | "azure"
LLM_PROVIDER=ollama
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# Sign Data
MOCAP_ARCHIVE_PATH=./data/mocap-archive
MOCAP_INDEXER_URL=http://localhost:5001
MOCAP_INDEXER_PORT=5001
VOCABULARY_DOMAIN=church

# Server
PORT=3000
WS_PORT=8080
NODE_ENV=development
