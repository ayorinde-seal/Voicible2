# Voicible Configuration
# "Every voice, made visible."
# Copy this file to .env and adjust values for your venue/deployment.

# ─── Voicible Configuration ──────────────────
VENUE_NAME=Voicible Live

# STT Provider: "whisper-live" | "azure"
STT_PROVIDER=whisper-live
WHISPER_LIVE_URL=ws://localhost:9090
WHISPER_LIVE_MODEL=small.en
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
# Segmentation strategy: "Semantic" (default, AI-inferred phrase boundaries,
# no adjustable timeout) | "Time" (silence-based — uses the timeout below) | "Default"
AZURE_SEGMENTATION_STRATEGY=Semantic
# Only applies when AZURE_SEGMENTATION_STRATEGY=Time — how much silence (ms)
# ends a phrase and triggers a final transcript.
AZURE_SEGMENTATION_SILENCE_TIMEOUT_MS=500

# LLM Provider: "ollama" | "azure"
LLM_PROVIDER=ollama
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
# Use the Foundry/AI Services RESOURCE endpoint (https://<resource>.services.ai.azure.com
# or https://<resource>.openai.azure.com), NOT the "Project" endpoint the Azure AI Foundry
# portal shows by default (.../api/projects/<name>) — that's for the Foundry SDK's
# agents/assistants API, not direct chat-completions REST calls.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Sign Data
MOCAP_ARCHIVE_PATH=./data/mocap-archive
MOCAP_INDEXER_URL=http://localhost:5001
MOCAP_INDEXER_PORT=5001
VOCABULARY_DOMAIN=church

# Streaming — how long (ms) a partial transcript must stop growing before
# new speech since the last chunk gets glossed+signed, instead of waiting
# for the STT provider's own final result.
STREAM_CHUNK_IDLE_MS=1200
# Hard ceiling — flush even mid-sentence if speech never pauses long
# enough to trigger the idle timeout above.
STREAM_CHUNK_MAX_WAIT_MS=3500

# Server
PORT=3000
WS_PORT=8080
NODE_ENV=development
